# ==============================================================================
# EventHub — Variables de Entorno (.env.example)
# Copiá este archivo a .env y completá los valores para tu entorno.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Base de Datos (PostgreSQL / Supabase / Neon) [OBLIGATORIAS]
# ------------------------------------------------------------------------------
# URL con connection pooling para Next.js / serverless (puerto 6543 en Supabase)
DATABASE_URL="postgresql://usuario:contraseña@servidor:6543/postgres?pgbouncer=true"

# URL directa sin pooling para migraciones Prisma / scripts DDL (puerto 5432 en Supabase)
DIRECT_URL="postgresql://usuario:contraseña@servidor:5432/postgres"

# (Opcional) Guard de seguridad en prisma.config.ts: lista de project refs permitidos separados por coma.
# Si se define, bloquea comandos de Prisma si la DB no coincide con ningún ref.
# ALLOWED_DB_PROJECT_REFS="tu-project-ref-1,tu-project-ref-2"

# (Opcional) DDL explícito: para correr comandos que alteran el schema (db push, migrate, studio)
# se requiere ALLOW_DB_PUSH=1 en el entorno.
# ALLOW_DB_PUSH="1"

# ------------------------------------------------------------------------------
# 2. Autenticación y Sesiones [OBLIGATORIAS]
# ------------------------------------------------------------------------------
# Secreto largo y aleatorio para firmar las cookies de sesión (HS256)
AUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio-minimo-32-caracteres"

# Credenciales del Superadmin de la plataforma (dueño de la instancia EventHub)
SUPERADMIN_EMAIL="admin@tudominio.com"
SUPERADMIN_PASSWORD="contraseña-fuerte-del-superadmin"

# (Opcional - Legacy) Fallback de compatibilidad con versiones anteriores de sesiones
# ADMIN_PASSWORD=""

# ------------------------------------------------------------------------------
# 2b. Registro self-service de dueños (F14) [OPCIONAL / DEFAULT: cerrado]
# ------------------------------------------------------------------------------
# Con ALLOW_SELF_SIGNUP="1", /registro permite que un tercero cree su cuenta de
# organizador solo (evento DRAFT + verificación por email + wizard del primer
# evento). Con "0" o sin definir, el registro está cerrado y /registro muestra
# un aviso. Rate limit: 5 registros/hora por IP.
# ALLOW_SELF_SIGNUP="0"

# ------------------------------------------------------------------------------
# 3. Envío de Correos (SMTP) [OBLIGATORIAS para confirmaciones y tickets]
# ------------------------------------------------------------------------------
# Configuración del servidor SMTP de la plataforma (Gmail, Resend, Sendgrid, etc.)
# Nota: el header reply-to se configura automáticamente con el email del dueño de cada evento.
SMTP_HOST="smtp.ejemplo.com"
SMTP_PORT="587"
SMTP_USER="tu-usuario-smtp"
SMTP_PASS="tu-contraseña-o-token-smtp"
SMTP_FROM='"EventHub" <noreply@tudominio.com>'

# ------------------------------------------------------------------------------
# 4. Almacenamiento de Comprobantes (Storage) [OPCIONAL / DEFAULT: db]
# ------------------------------------------------------------------------------
# Modo de almacenamiento:
# - "db": guarda comprobantes como base64 en la base de datos (PostgreSQL). Ideal desarrollo o eventos pequeños.
# - "r2": Cloudflare R2 object storage (recomendado para producción, free tier 10GB).
# - "blob": Vercel Blob storage.
STORAGE_MODE="db"

# --- Cloudflare R2 (obligatorias solo si STORAGE_MODE="r2") ---
# R2_ACCOUNT_ID="tu-cloudflare-account-id"
# R2_BUCKET="tu-bucket-r2"
# R2_ACCESS_KEY_ID="tu-access-key-id"
# R2_SECRET_ACCESS_KEY="tu-secret-access-key"
# R2_REGION="auto"
# R2_ENDPOINT="https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com"
# R2_PUBLIC_URL="https://tu-bucket.tudominio.com"

# --- Vercel Blob (obligatoria solo si STORAGE_MODE="blob") ---
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# ------------------------------------------------------------------------------
# 5. Seed demo genérico (F11) [OPCIONAL / DEFAULT: demo-festival + demo-conferencia]
# ------------------------------------------------------------------------------
# npx tsx prisma/seed.ts crea dos eventos demo sin marca real. Todos los valores
# se pueden pisar con estas variables. Ver docs/adaptar-evento.md.
# SEED_EVENT_A_SLUG="demo-festival"
# SEED_EVENT_A_NAME="Demo Festival"
# SEED_EVENT_A_PRICE_CENTS="500000"
# SEED_EVENT_A_COMMISSION_CENTS="100000"
# SEED_EVENT_A_CURRENCY="ARS"
# SEED_EVENT_A_PAY_ALIAS="demo.festival.pagos"
# SEED_EVENT_A_CONTACT="hola@demo-festival.ejemplo"
# SEED_EVENT_A_MAX_TICKETS=""
# SEED_EVENT_B_SLUG="demo-conferencia"
# SEED_EVENT_B_NAME="Demo Conferencia"
# SEED_EVENT_B_PRICE_CENTS="1000000"
# SEED_EVENT_B_COMMISSION_CENTS="200000"
# SEED_EVENT_B_CURRENCY="ARS"
# SEED_EVENT_B_PAY_ALIAS="demo.conferencia.pagos"
# SEED_EVENT_B_CONTACT="hola@demo-conferencia.ejemplo"
# SEED_EVENT_B_MAX_TICKETS="500"
